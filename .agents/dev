#!/usr/bin/env bash
set -euo pipefail

nix_bin="$HOME/.nix-profile/bin/nix"
repo_root="$(cd "$(dirname "$BASH_SOURCE")/.." && pwd)"

if [[ ! -x "$nix_bin" ]]; then
  echo "Nix is not installed; run .agents/setup first." >&2
  exit 1
fi

exec "$nix_bin" --extra-experimental-features 'nix-command flakes' \
  develop "$repo_root" --command "$@"
