#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$BASH_SOURCE")/.." && pwd)"
nix_version="2.35.1"
nix_sha256="c3fe29778acaa93b5095ee66e36f11ec7c6a284c40970a24cc83ac4f04809db3"

if [[ -x "$HOME/.nix-profile/bin/nix" ]]; then
  nix_bin="$HOME/.nix-profile/bin/nix"
elif command -v nix >/dev/null 2>&1; then
  nix_bin="$(command -v nix)"
else
  nix_bin="$HOME/.nix-profile/bin/nix"
fi

run_step() {
  local label="$1"
  shift
  printf '\n==> %s\n' "$label"
  time "$@"
}

if [[ ! -x "$nix_bin" ]]; then
  if [[ "$(uname -s)" != "Linux" || "$(uname -m)" != "x86_64" ]]; then
    echo ".agents/setup can install Nix only in x86-64 Linux orbs; install Nix before rerunning setup." >&2
    exit 1
  fi

  if [[ -e /nix ]]; then
    echo "/nix already exists but Nix is unavailable; refusing to change its ownership." >&2
    exit 1
  fi

  run_step "Installing Nix $nix_version" bash -o errexit -o nounset -o pipefail -c '
    tarball="$(mktemp)"
    unpack_dir="$(mktemp -d)"
    trap "rm -f \"$tarball\"; rm -rf \"$unpack_dir\"" EXIT
    curl --fail --location --proto "=https" --tlsv1.2 \
      "https://releases.nixos.org/nix/nix-'"$nix_version"'/nix-'"$nix_version"'-x86_64-linux.tar.xz" \
      --output "$tarball"
    echo "'"$nix_sha256"'  $tarball" | sha256sum --check --status
    sudo install -d -m 0755 -o "$USER" -g "$(id -gn)" /nix
    tar -xJf "$tarball" -C "$unpack_dir"
    "$unpack_dir"/nix-'"$nix_version"'-x86_64-linux/install --no-daemon
  '
fi

if [[ -f "$HOME/.nix-profile/etc/profile.d/nix.sh" ]]; then
  # The installer cannot change this script's environment.
  # shellcheck disable=SC1091
  source "$HOME/.nix-profile/etc/profile.d/nix.sh"
fi

cd "$repo_root"
run_step "Fetching locked Cargo dependencies through the Nix development shell" \
  .agents/dev cargo fetch --locked

jj_user_name="$(.agents/dev jj config get user.name 2>/dev/null || true)"
jj_user_email="$(.agents/dev jj config get user.email 2>/dev/null || true)"
set_jj_user_name=false
set_jj_user_email=false

if [[ -z "$jj_user_name" ]]; then
  jj_user_name="$(git config --get user.name 2>/dev/null || true)"
  if [[ -z "$jj_user_name" ]]; then
    echo "Configure Git or Jujutsu user.name before initializing Jujutsu." >&2
    exit 1
  fi
  set_jj_user_name=true
fi

if [[ -z "$jj_user_email" ]]; then
  jj_user_email="$(git config --get user.email 2>/dev/null || true)"
  if [[ -z "$jj_user_email" ]]; then
    echo "Configure Git or Jujutsu user.email before initializing Jujutsu." >&2
    exit 1
  fi
  set_jj_user_email=true
fi

created_jj=false
if [[ ! -d "$repo_root/.jj" ]]; then
  run_step "Initializing colocated Jujutsu repository" .agents/dev jj git init --colocate
  created_jj=true
fi

if ! .agents/dev jj --ignore-working-copy root >/dev/null; then
  echo "Existing .jj metadata is invalid; repair it before rerunning setup." >&2
  exit 1
fi

colocation_status="$(.agents/dev jj git colocation status)"
if [[ "$colocation_status" != *"currently colocated"* ]]; then
  echo "Existing .jj metadata is not colocated with Git; repair it before rerunning setup." >&2
  exit 1
fi

if [[ "$set_jj_user_name" == true ]]; then
  jj_user_name_toml="$(printf '%s' "$jj_user_name" | .agents/dev jq --raw-input --slurp .)"
  .agents/dev jj config set --repo user.name "$jj_user_name_toml"
fi

if [[ "$set_jj_user_email" == true ]]; then
  jj_user_email_toml="$(printf '%s' "$jj_user_email" | .agents/dev jq --raw-input --slurp .)"
  .agents/dev jj config set --repo user.email "$jj_user_email_toml"
fi

if [[ "$created_jj" == true ]]; then
  .agents/dev jj metaedit --update-author
fi
